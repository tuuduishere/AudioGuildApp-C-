<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.HistoryPage"
             Title="Lịch sử hành trình"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="15">
            <Label Text="📜 Lịch sử tham quan" FontSize="24" FontAttributes="Bold" TextColor="#1E88E5" Margin="0,0,0,10"/>

            <VerticalStackLayout x:Name="HistoryContainer" Spacing="10" />

            <Button x:Name="BtnClearHistory" Text="🗑 Xóa lịch sử" BackgroundColor="#E53935" TextColor="White" CornerRadius="8" Margin="0,20,0,0" Clicked="OnClearHistoryClicked" IsVisible="False"/>
            <Label x:Name="LblEmpty" Text="Bạn chưa ghé thăm địa điểm nào cả." FontAttributes="Italic" TextColor="Gray" HorizontalOptions="Center" Margin="0,50,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>