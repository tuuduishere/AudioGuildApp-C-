<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.TourListPage"
             Title="Danh sách Tuyến đi"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,20">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="⬅" FontSize="24" TextColor="Gray" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseClicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Bản đồ Tuyến đi" FontSize="24" FontAttributes="Bold" TextColor="#1565C0" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Khám phá các tour ẩm thực, di tích nổi bật nhất được thiết kế dành riêng cho bạn." TextColor="Gray" FontSize="14" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="RefreshTours" Refreshing="OnRefreshTours">
            <CollectionView x:Name="ListTours" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,15" Padding="15" CornerRadius="12" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=SelectTourCommand}" CommandParameter="{Binding TourId}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#333333" />
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="🗺️" FontSize="24" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Đang tải danh sách tuyến đi..." HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" Text="Xóa bộ lọc (Hiển thị lại toàn bộ bản đồ)" BackgroundColor="#E0E0E0" TextColor="#D32F2F" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Margin="0,10,0,0" Clicked="OnClearFilterClicked" />

    </Grid>
</ContentPage>