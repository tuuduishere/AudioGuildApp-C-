<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.Mobile.Views.OnboardingPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">
        <Image Source="https://images.unsplash.com/photo-1503220317375-aaad61436b1b" 
               Aspect="AspectFill" Grid.RowSpan="2" Opacity="0.8"/>

        <BoxView Grid.RowSpan="2">
            <BoxView.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <VerticalStackLayout Grid.Row="1" Padding="30" Spacing="20">
            <Label Text="Khám Phá Thế Giới" FontSize="32" FontAttributes="Bold" TextColor="White"/>
            <Label Text="Ứng dụng hướng dẫn du lịch thông minh với tính năng thuyết minh tự động khi bạn đến gần địa điểm." 
                   TextColor="LightGray" FontSize="16"/>

            <Button Text="BẮT ĐẦU NGAY" 
                    BackgroundColor="#3498db" 
                    TextColor="White" 
                    HeightRequest="60" 
                    CornerRadius="30"
                    FontAttributes="Bold"
                    Clicked="OnStartClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>