<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.SettingsPage"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Padding="15,20,15,15">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *">
                <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="5">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="BtnBack_Clicked" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="❮" FontSize="20" FontAttributes="Bold" TextColor="#FFC107" VerticalOptions="Center"/>
                    <Label Text="Quay lại" FontSize="16" FontAttributes="Bold" TextColor="#FFC107" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Column="1" Text="Cài đặt hệ thống" FontSize="18" FontAttributes="Bold" TextColor="#333" HorizontalOptions="End" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="25">

                <Label Text="Trợ lý AI Thuyết minh" FontSize="14" FontAttributes="Bold" TextColor="Gray" Margin="0,0,0,-15"/>
                <Border BackgroundColor="White" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Tự động phát thuyết minh" VerticalOptions="Center" TextColor="#333" FontSize="16"/>
                            <Switch x:Name="SwitchAutoPlay" Grid.Column="1" OnColor="#FFC107" Toggled="OnSettingChanged"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEEEEE"/>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Tốc độ đọc:" TextColor="#333" FontSize="16" VerticalOptions="Center"/>
                            <Label x:Name="LabelSpeed" Text="1.0x" TextColor="#FFC107" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Slider x:Name="SliderSpeed" Minimum="0.5" Maximum="2.0" Value="1.0" MinimumTrackColor="#FFC107" ValueChanged="OnSliderValueChanged" DragCompleted="OnSettingChanged"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Quản lý Dữ liệu" FontSize="14" FontAttributes="Bold" TextColor="Gray" Margin="0,0,0,-15"/>
                <VerticalStackLayout Spacing="15">
                    <Button Text="🔄 Đồng bộ dữ liệu mới nhất" Clicked="BtnSync_Clicked" 
                            BackgroundColor="#E3F2FD" TextColor="#1976D2" FontAttributes="Bold" CornerRadius="12" HeightRequest="50"/>
                    <Button Text="🗑 Xóa lịch sử tham quan" Clicked="BtnClearHistory_Clicked" 
                            BackgroundColor="#FFEBEE" TextColor="#D32F2F" FontAttributes="Bold" CornerRadius="12" HeightRequest="50"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>