<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.RegisterPage"
             BackgroundColor="#F4F6F8"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <BoxView Color="#00838F" HeightRequest="250" VerticalOptions="Start" />

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="20" VerticalOptions="Center">

                <Label Text="TẠO TÀI KHOẢN" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" Margin="0,50,0,40"/>

                <Frame BackgroundColor="White" CornerRadius="20" HasShadow="True" Padding="25" Margin="10,0" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="15">
                        <Frame Padding="0" CornerRadius="10" BorderColor="#E0E0E0" BackgroundColor="#FAFAFA" HasShadow="False" HeightRequest="50">
                            <Grid ColumnDefinitions="45, *">
                                <Path Grid.Column="0" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="#00838F" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="EntryUsername" Placeholder="Tên đăng nhập" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <Frame Padding="0" CornerRadius="10" BorderColor="#E0E0E0" BackgroundColor="#FAFAFA" HasShadow="False" HeightRequest="50">
                            <Grid ColumnDefinitions="45, *">
                                <Path Grid.Column="0" Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" Fill="#00838F" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="EntryEmail" Placeholder="Địa chỉ Email" Keyboard="Email" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <Frame Padding="0" CornerRadius="10" BorderColor="#E0E0E0" BackgroundColor="#FAFAFA" HasShadow="False" HeightRequest="50">
                            <Grid ColumnDefinitions="45, *">
                                <Path Grid.Column="0" Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" Fill="#00838F" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="EntryPassword" Placeholder="Mật khẩu bảo mật" IsPassword="True" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <Button x:Name="BtnRegister" Text="ĐĂNG KÝ NGAY" BackgroundColor="#00838F" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="55" Clicked="OnRegisterClicked" Margin="0,15,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,30,0,0" Spacing="5">
                    <Label Text="Đã có tài khoản?" TextColor="Gray" VerticalOptions="Center"/>
                    <Label Text="Đăng nhập" TextColor="#00838F" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToLoginClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>