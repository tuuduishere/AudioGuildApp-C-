                        <VerticalStackLayout VerticalOptions="Center">
                            <Label x:Name="LblUsername" Text="Đang tải..." FontSize="20" FontAttributes="Bold" TextColor="Black" />
                            <Label x:Name="LblRole" Text="Thành viên" FontSize="14" TextColor="Gray" />
