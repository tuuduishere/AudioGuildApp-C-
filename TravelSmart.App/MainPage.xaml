<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource AppPadding}" Spacing="12">
            <!-- Header -->
            <Frame CornerRadius="14" Padding="16" HasShadow="True" BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout>
                    <Label Text="TravelSmart" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Khám phá điểm đến xung quanh bạn" FontSize="14" TextColor="#EDEBFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- Quick search -->
            <SearchBar Placeholder="Tìm địa điểm, quán ăn..." CancelButtonColor="{StaticResource Gray500}"/>

            <!-- Action cards -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Frame Style="{StaticResource CardFrame}" BackgroundColor="White">
                    <HorizontalStackLayout Spacing="12" Padding="6" VerticalOptions="Center">
                        <Label Text="🔎" FontSize="28" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="Khám phá" Style="{StaticResource CardTitle}" />
                            <Label Text="Xem danh sách địa điểm nổi bật" Style="{StaticResource CardSubtitle}" />
                        </VerticalStackLayout>
                        <Button Text="Mở →" Clicked="OpenExplore" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}" BackgroundColor="White">
                    <HorizontalStackLayout Spacing="12" Padding="6" VerticalOptions="Center">
                        <Label Text="🗺️" FontSize="28" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="Bản đồ" Style="{StaticResource CardTitle}" />
                            <Label Text="Xem bản đồ các địa điểm" Style="{StaticResource CardSubtitle}" />
                        </VerticalStackLayout>
                        <Button Text="Mở →" Clicked="OpenMap" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}" Grid.Row="1" BackgroundColor="White">
                    <HorizontalStackLayout Spacing="12" Padding="6" VerticalOptions="Center">
                        <Label Text="🍽️" FontSize="28" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="Ẩm thực" Style="{StaticResource CardTitle}" />
                            <Label Text="Khám phá quán ăn, món ngon" Style="{StaticResource CardSubtitle}" />
                        </VerticalStackLayout>
                        <Button Text="Mở →" Clicked="OpenFood" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}" Grid.Row="1" Grid.Column="1" BackgroundColor="White">
                    <HorizontalStackLayout Spacing="12" Padding="6" VerticalOptions="Center">
                        <Label Text="⭐" FontSize="28" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="Yêu thích" Style="{StaticResource CardTitle}" />
                            <Label Text="Xem các địa điểm bạn đã đánh dấu" Style="{StaticResource CardSubtitle}" />
                        </VerticalStackLayout>
                        <Button Text="Mở →" Clicked="OpenFavorites" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
