<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TravelSmart.Mobile.ViewModels"
             x:DataType="viewmodel:PlaceDetailViewModel"
             x:Class="TravelSmart.Mobile.Views.PlaceDetailPage"
             Title="{Binding SelectedPlace.Name}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <Border StrokeShape="RoundRectangle 0,0,30,30" 
                        HeightRequest="300" 
                        Margin="0" 
                        StrokeThickness="0">
                    <Image Source="{Binding SelectedPlace.ImageUrl}" Aspect="AspectFill"/>
                </Border>

                <VerticalStackLayout Padding="25" Spacing="15">
                    <Label Text="{Binding SelectedPlace.Name}" FontSize="28" FontAttributes="Bold" TextColor="#2C3E50"/>
                    <Label Text="{Binding SelectedPlace.Address}" FontSize="15" TextColor="Gray"/>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="⭐" VerticalOptions="Center"/>
                        <Label Text="{Binding SelectedPlace.Rating}" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>
                    <Label Text="Giới thiệu" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{Binding SelectedPlace.Description}" FontSize="16" LineHeight="1.4" TextColor="#444"/>

                    <BoxView HeightRequest="100" Color="Transparent"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Text="{Binding PlayPauseIcon}"
                Command="{Binding PlayPauseAudioCommand}"
                BackgroundColor="#3498db"
                TextColor="White"
                FontSize="24"
                WidthRequest="66"
                HeightRequest="66"
                CornerRadius="33"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="25">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="15" Opacity="0.2"/>
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>