@page "/pois"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="container mt-4 position-relative">
    <InputFile id="globalFileInput" OnChange="HandleFileSelected" accept="@_acceptType" style="display:none;" />

    @if (string.IsNullOrEmpty(selectedPoiId))
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>🏪 Quản lý Quán ăn</h2>
            @if (userRole == "Merchant" || userRole == "Admin")
            {
                <button class="btn btn-primary fw-bold" @onclick="OpenCreateForm">+ Thêm Quán Mới</button>
            }
        </div>

        @if (showForm && (userRole == "Merchant" || userRole == "Admin"))
        {
            <div class="card shadow-sm mb-4 border-primary">
                <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                    <span>@(isEditing ? "✏️ CHỈNH SỬA THÔNG TIN QUÁN" : "➕ NHẬP THÔNG TIN QUÁN MỚI")</span>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseForm"></button>
                </div>
                <div class="card-body row g-3">
                    <div class="col-md-12">
                        <label class="fw-bold text-dark">Tên Quán: <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="newPoi.Name" placeholder="Tên quán (VD: Ốc Oanh)" />
                    </div>
                    
                    <div class="col-md-12 position-relative">
                        <label class="fw-bold text-primary mb-1">🔍 Tìm địa chỉ hoặc Nhấp thẳng lên bản đồ: <span class="text-danger">*</span></label>
                        <div class="input-group mb-2">
                            <input class="form-control border-primary" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" placeholder="Gõ địa chỉ rồi ấn Enter..." />
                            <button class="btn btn-warning fw-bold" type="button" @onclick="SearchAddress">Tìm Điểm</button>
                        </div>
                        @if (addressSuggestions != null && addressSuggestions.Any())
                        {
                            <ul class="list-group position-absolute w-100 shadow-lg" style="z-index: 1000; top: 70px;">
                                @foreach (var s in addressSuggestions)
                                {
                                    <li class="list-group-item list-group-item-action" style="cursor: pointer;" @onclick="() => SelectAddress(s)">📍 @s.display_name</li>
                                }
                            </ul>
                        }
                        <div id="mapPicker" style="height: 300px; width: 100%; border-radius: 8px; border: 2px solid #0d6efd; z-index: 1;"></div>
                    </div>

                    <div class="col-md-12">
                        <label class="fw-bold text-dark">Địa chỉ chi tiết:</label>
                        <input id="addressInput" class="form-control bg-light" @bind="newPoi.Address" @bind:event="oninput" placeholder="Tự động điền khi click bản đồ..." />
                    </div>
                    
                    <div class="col-md-6">
                        <label class="fw-bold text-dark">Vĩ độ:</label>
                        <input id="latInput" class="form-control bg-light fw-bold text-danger" @bind="newPoi.Latitude" type="number" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark">Kinh độ:</label>
                        <input id="lngInput" class="form-control bg-light fw-bold text-danger" @bind="newPoi.Longitude" type="number" readonly />
                    </div>
                    
                    <div class="col-md-12">
                        <label class="fw-bold text-dark">Mô tả giới thiệu:</label>
                        <textarea class="form-control" @bind="newPoi.Description" placeholder="Đoạn văn này AI sẽ dịch và đọc làm thuyết minh..."></textarea>
                    </div>

                    <div class="col-md-12 text-end">
                        <button class="btn btn-secondary me-2" @onclick="CloseForm">Hủy</button>
                        <button class="btn btn-success fw-bold" @onclick="SavePoi" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <span>@(isEditing ? "💾 Cập nhật" : "Lưu Quán")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (listPois == null)
        {
            <div class="spinner-border text-primary"></div>
        }
        else
        {
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr><th>Tên Quán</th><th>Địa chỉ</th><th>Trạng thái Audio</th><th class="text-center">Thao tác</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in listPois)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@p.Name</td>
                                    <td class="small">@p.Address</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.AudioUrl))
                                        {
                                            <span class="badge bg-success me-1">🎵 MP3 ĐÃ TẢI LÊN</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary me-1">🤖 GIỌNG AI MẶC ĐỊNH</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="dropdown position-relative">
                                            <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" @onclick="() => ToggleDropdown(p.Id)">⚙️ Tùy chọn</button>
                                            @if (_activeDropdownId == p.Id)
                                            {
                                                <ul class="dropdown-menu shadow-lg show" style="display: block; position: absolute; right: 0; top: 100%; z-index: 1050; min-width: 200px;">
                                                    <li><button class="dropdown-item fw-bold text-primary" @onclick="() => ViewPoiDetails(p.Id, p.Name)">📝 Quản lý Menu & Review</button></li>
                                                    <li><button class="dropdown-item" @onclick="() => ShowQrModal(p.QrCodeKey, p.Name)">📱 Xem mã QR Code</button></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    @if (userRole == "Merchant" || userRole == "Admin")
                                                    {
                                                        <li><button class="dropdown-item fw-bold text-warning" @onclick="() => EditPoi(p)">✏️ Sửa thông tin Quán</button></li>
                                                        <li><button class="dropdown-item mb-0" @onclick='() => TriggerUpload(p.Id, "audio")'>🎵 Tải lên MP3 Thuyết minh</button></li>
                                                        <li><button class="dropdown-item mb-0" @onclick='() => TriggerUpload(p.Id, "image")'>🖼 Tải lên Ảnh Quán</button></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><button class="dropdown-item text-danger fw-bold" @onclick="() => DeletePoi(p.Id)">🗑 Xóa Quán Ăn</button></li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>🍽 Quản lý: <span class="text-primary">@selectedPoiName</span></h2>
            <button class="btn btn-secondary fw-bold" @onclick="CloseDetails">⬅ Quay lại</button>
        </div>
        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-warning fw-bold text-dark">THỰC ĐƠN (MENU)</div>
                    <div class="card-body">
                        @if (userRole == "Merchant" || userRole == "Admin")
                        {
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" placeholder="Tên món..." @bind="newItem.ItemName">
                                    <input type="number" class="form-control" placeholder="Giá tiền..." @bind="newItem.Price">
                                        <button class="btn btn-primary" type="button" @onclick="AddMenuItem">+ Thêm món</button>
                                    </div>
                                }
                                <table class="table table-sm">
                                    <thead><tr><th>Tên món</th><th>Giá bán</th><th></th></tr></thead>
                                    <tbody>
                                        @if (poiDetails?.Menu != null)
                                        {
                                            @foreach (var m in poiDetails.Menu)
                                            {
                                                <tr>
                                                    <td class="fw-bold">@m.ItemName</td>
                                                    <td class="text-success">@m.Price.ToString("N0") đ</td>
                                                    <td class="text-end">
                                                        @if (userRole == "Merchant" || userRole == "Admin")
                                                        {
                                                            <button class="btn btn-sm btn-danger py-0" @onclick="() => DeleteMenuItem(m.ItemId)">X</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-success fw-bold text-white">ĐÁNH GIÁ TỪ KHÁCH HÀNG</div>
                            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                                @if (poiDetails?.Reviews != null && poiDetails.Reviews.Count > 0)
                                {
                                    @foreach (var r in poiDetails.Reviews)
                                    {
                                        <div class="mb-3 border-bottom pb-2">
                                            <div class="text-warning fw-bold">@for (int i=0; i<r.Rating; i++) {
                                                <span>⭐</span>
                                            }
                                        </div>
                                        <div class="fst-italic">"@r.Comment"</div>
                                        <small class="text-muted">Gửi lúc: @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                }
                            }
                        else
                            {
                                <p class="text-muted">Chưa có đánh giá nào.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (isQrModalOpen)
        {
            <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6);" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-4 shadow-lg">
                        <div class="modal-header bg-dark text-white border-0 rounded-top-4">
                            <h5 class="modal-title fw-bold">QR Code: @currentQrPoiName</h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseQrModal"></button>
                        </div>
                        <div class="modal-body text-center p-4">
                            <img src="@currentQrUrl" alt="QR Code" class="img-fluid border border-3 rounded-3 mb-3 p-2" style="max-width: 250px;" />
                            <p class="text-muted small">Khách hàng quét mã này bằng <strong>TravelSmart App</strong> để nghe thuyết minh!</p>
                        </div>
                        <div class="modal-footer border-0 justify-content-center">
                            <button class="btn btn-secondary fw-bold px-4" @onclick="CloseQrModal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

@code {
    private List<PoiDto> listPois;
    private PoiCreateDto newPoi = new();
    private bool showForm = false;
    private bool isEditing = false;
    private string editingPoiId = "";
    private bool isSaving = false;

    private string userRole = "";
    private string apiBase = "https://localhost:7008/api/Pois";
    private string selectedPoiId = "";
    private string selectedPoiName = "";
    private PoiDetailDto poiDetails = new();
    private MenuItemCreateDto newItem = new();
    private string searchQuery = "";
    private List<OSMResult> addressSuggestions = new();
    private bool isQrModalOpen = false;
    private string currentQrUrl = "";
    private string currentQrPoiName = "";
    private string _activeDropdownId = "";

    private string _uploadingPoiId = "";
    private string _uploadType = "";
    private string _acceptType = ".mp3";

    protected override async Task OnInitializedAsync()
    {
        userRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
        await LoadData();
    }

    private void ToggleDropdown(string id)
    {
        if (_activeDropdownId == id) _activeDropdownId = "";
        else _activeDropdownId = id;
    }

    private async Task OpenCreateForm()
    {
        isEditing = false; newPoi = new PoiCreateDto(); showForm = true; _activeDropdownId = "";
        await Task.Delay(200); await JS.InvokeVoidAsync("initMapPicker");
    }

    private async Task EditPoi(PoiDto p)
    {
        _activeDropdownId = ""; isEditing = true; editingPoiId = p.Id;
        newPoi.Name = p.Name; newPoi.Address = p.Address; newPoi.Description = p.Description;
        newPoi.Latitude = p.Latitude; newPoi.Longitude = p.Longitude;
        showForm = true;
        await Task.Delay(200); await JS.InvokeVoidAsync("initMapPicker");
        await JS.InvokeVoidAsync("flyToMap", p.Latitude, p.Longitude);
    }

    private void CloseForm() { showForm = false; isEditing = false; }
    private void CloseDetails() { selectedPoiId = ""; selectedPoiName = ""; }

    private async Task LoadData()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        listPois = await Http.GetFromJsonAsync<List<PoiDto>>(apiBase) ?? new List<PoiDto>();
        StateHasChanged();
    }

    private async Task TriggerUpload(string poiId, string type)
    {
        _uploadingPoiId = poiId; _uploadType = type; _acceptType = type == "audio" ? ".mp3" : ".jpg,.jpeg,.png";
        _activeDropdownId = ""; StateHasChanged();
        await JS.InvokeVoidAsync("eval", "document.getElementById('globalFileInput').click()");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File; if (file == null || string.IsNullOrEmpty(_uploadingPoiId)) return;
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(20 * 1024 * 1024);
            var memoryStream = new MemoryStream(); await stream.CopyToAsync(memoryStream); memoryStream.Position = 0;
            var fileContent = new StreamContent(memoryStream); fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var endpoint = _uploadType == "audio" ? "upload-audio" : "upload-image";
            var response = await Http.PostAsync($"{apiBase}/{_uploadingPoiId}/{endpoint}", content);

            if (response.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "🎉 Đã tải lên thành công!"); await LoadData(); }
            else await JS.InvokeVoidAsync("alert", "Lỗi khi tải file lên.");
        }
        catch { await JS.InvokeVoidAsync("alert", "Lỗi. Hãy F5 trang!"); }
        finally { _uploadingPoiId = ""; }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchAddress(); }
    private async Task SearchAddress()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        try
        {
            using var client = new HttpClient(); client.DefaultRequestHeaders.Add("User-Agent", "TravelSmartApp/1.0");
            var url = $"https://nominatim.openstreetmap.org/search?format=json&q={Uri.EscapeDataString(searchQuery)}&limit=5";
            addressSuggestions = await client.GetFromJsonAsync<List<OSMResult>>(url);
        }
        catch { }
    }
    
    private async Task SelectAddress(OSMResult result)
    {
        newPoi.Address = result.display_name;
        newPoi.Latitude = double.Parse(result.lat, System.Globalization.CultureInfo.InvariantCulture);
        newPoi.Longitude = double.Parse(result.lon, System.Globalization.CultureInfo.InvariantCulture);
        addressSuggestions.Clear();
        await JS.InvokeVoidAsync("flyToMap", newPoi.Latitude, newPoi.Longitude);
    }
    
    private void ShowQrModal(string qrKey, string poiName) { _activeDropdownId = ""; currentQrPoiName = poiName; currentQrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={qrKey}"; isQrModalOpen = true; }
    private void CloseQrModal() => isQrModalOpen = false;

    private async Task SavePoi()
    {
        if (string.IsNullOrWhiteSpace(newPoi.Name) || newPoi.Latitude == 0 || string.IsNullOrWhiteSpace(newPoi.Address)) { await JS.InvokeVoidAsync("alert", "⚠️ Điền đủ Tên, Tọa độ và Địa chỉ sếp ơi!"); return; }
        isSaving = true; StateHasChanged();

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        
        HttpResponseMessage response;
        if (isEditing) response = await Http.PutAsJsonAsync($"{apiBase}/{editingPoiId}", newPoi);
        else { newPoi.QrCodeKey = "QR_" + DateTime.Now.Ticks.ToString().Substring(10); response = await Http.PostAsJsonAsync(apiBase, newPoi); }

        if (response.IsSuccessStatusCode) { newPoi = new PoiCreateDto(); showForm = false; isEditing = false; await LoadData(); }
        else await JS.InvokeVoidAsync("alert", "❌ Có lỗi Server, chưa lưu được sếp ơi!");
        
        isSaving = false; StateHasChanged();
    }

    private async Task DeletePoi(string id) { _activeDropdownId = ""; if (await JS.InvokeAsync<bool>("confirm", "Xóa quán này sẽ bay luôn Menu. Chắc chưa?")) { var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken"); Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token); await Http.DeleteAsync($"{apiBase}/{id}"); await LoadData(); } }
    private async Task ViewPoiDetails(string id, string name) { _activeDropdownId = ""; selectedPoiId = id; selectedPoiName = name; await LoadPoiDetails(); }
    private async Task LoadPoiDetails() { var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken"); Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token); poiDetails = await Http.GetFromJsonAsync<PoiDetailDto>($"{apiBase}/{selectedPoiId}"); }
    private async Task AddMenuItem() { if (string.IsNullOrEmpty(newItem.ItemName) || newItem.Price <= 0) return; var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken"); Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token); var response = await Http.PostAsJsonAsync($"{apiBase}/{selectedPoiId}/menu", newItem); if (response.IsSuccessStatusCode) { newItem = new MenuItemCreateDto(); await LoadPoiDetails(); } }
    private async Task DeleteMenuItem(string itemId) { var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken"); Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token); await Http.DeleteAsync($"{apiBase}/menu/{itemId}"); await LoadPoiDetails(); }

    public class OSMResult { public string display_name { get; set; } public string lat { get; set; } public string lon { get; set; } }
    public class PoiDto { public string Id { get; set; } public string Name { get; set; } public string Address { get; set; } public string QrCodeKey { get; set; } public string AudioUrl { get; set; } public string ImageUrl { get; set; } public double Latitude { get; set; } public double Longitude { get; set; } public string Description { get; set; } }
    public class PoiCreateDto { public string Name { get; set; } public string Address { get; set; } public double Latitude { get; set; } public double Longitude { get; set; } public string Description { get; set; } public string QrCodeKey { get; set; } }
    public class MenuItemCreateDto { public string ItemName { get; set; } public decimal Price { get; set; } }
    public class PoiDetailDto { public List<MenuItemDto> Menu { get; set; } public List<ReviewDto> Reviews { get; set; } }
    public class MenuItemDto { public string ItemId { get; set; } public string ItemName { get; set; } public decimal Price { get; set; } }
    public class ReviewDto { public int Rating { get; set; } public string Comment { get; set; } public DateTime CreatedAt { get; set; } }
}