@page "/"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Bảng Điều Khiển</PageTitle>

<div class="container mt-4">
    @if (summary == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang kéo dữ liệu từ máy chủ...</p>
        </div>
    }
    else
    {
        <h2 class="mb-4">Chào mừng @(summary.Role == "Admin" ? "Quản trị viên" : "Chủ quán")!</h2>
        <hr class="mb-4" />

        <div class="alert alert-warning mb-4 d-flex align-items-center" style="gap: 15px;">
            <h6 class="mb-0 fw-bold">⚙️ Link Cloudflare hôm nay:</h6>
            <input type="text" class="form-control w-50" @bind="serverUrl" placeholder="Dán link Cloudflare vào đây..." />
            <button class="btn btn-dark" @onclick="UpdateQR">Cập Nhật QR</button>
        </div>

        <div class="row g-4 mb-4">
            @if (summary.Role == "Admin")
            {
                <div class="col-md-4">
                    <div class="card bg-primary text-white p-4 shadow-sm border-0 rounded-4 h-100">
                        <h6 class="opacity-75 fw-bold">TỔNG THÀNH VIÊN</h6>
                        <h2 class="display-5 fw-bold mb-0">@summary.TotalUsers</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white p-4 shadow-sm border-0 rounded-4 h-100">
                        <h6 class="opacity-75 fw-bold">DOANH THU TOÀN HỆ THỐNG</h6>
                        <h2 class="display-5 fw-bold mb-0">@summary.TotalRevenue.ToString("N0") đ</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-info text-white p-4 shadow-sm border-0 rounded-4 h-100">
                        <h6 class="opacity-75 fw-bold">QUÁN ĐANG HOẠT ĐỘNG</h6>
                        <h2 class="display-5 fw-bold mb-0">@summary.TotalPois</h2>
                    </div>
                </div>
            }
            else if (summary.Role == "Merchant")
            {
                <div class="col-md-4">
                    <div class="card bg-success text-white p-4 shadow-sm border-0 rounded-4 h-100">
                        <h6 class="opacity-75 fw-bold">DOANH THU CỦA TÔI</h6>
                        <h2 class="display-5 fw-bold mb-0">@summary.TotalRevenue.ToString("N0") đ</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-warning text-dark p-4 shadow-sm border-0 rounded-4 h-100">
                        <h6 class="opacity-75 fw-bold">TỔNG ĐƠN HÀNG</h6>
                        <h2 class="display-5 fw-bold mb-0">@summary.TotalOrders Đơn</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-danger text-white p-4 shadow-sm border-0 rounded-4 h-100">
                        <h6 class="opacity-75 fw-bold">ĐÁNH GIÁ TRUNG BÌNH</h6>
                        <h2 class="display-5 fw-bold mb-0">@summary.AverageRating ⭐</h2>
                    </div>
                </div>
            }
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                    <h4 class="mb-4 text-primary"><i class="bi bi-broadcast me-2"></i>Thống Kê Real-time & Heatmap</h4>
                    
                    <div class="alert alert-info d-flex align-items-center mb-4">
                        <h2 class="mb-0 fw-bold text-primary">@totalOnline<span class="fs-6 text-muted ms-2">người</span></h2>
                        <div class="ms-3">
                            <h6 class="mb-0 text-dark">Số lượng thiết bị đang truy cập App.</h6>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3">Biểu Đồ Lượt Nghe (7 ngày qua):</h6>
                    <div class="mb-4 bg-light p-3 rounded-3 border">
                        @if (heatmapList == null || !heatmapList.Any())
                        {
                            <p class="text-muted fst-italic mb-0">Chưa có dữ liệu Heatmap.</p>
                        }
                        else
                        {
                            @foreach (var item in heatmapList)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span style="width: 60px; font-weight: bold; font-size: 0.9rem;">@item.Date</span>
                                    <div class="progress flex-grow-1" style="height: 20px; border-radius: 4px;">
                                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(Math.Min(100, item.Count * 10))%">
                                            @item.Count lượt
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <h6 class="fw-bold mb-3">Du khách đang xem chi tiết quán:</h6>
                    <div class="row">
                        @if (!liveViewers.Any(v => v.Value > 0))
                        {
                            <div class="col-12"><p class="text-muted fst-italic">Hiện chưa có ai mở xem quán nào.</p></div>
                        }
                        else
                        {
                            @foreach (var kvp in liveViewers.Where(v => v.Value > 0))
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card border-primary shadow-sm text-center">
                                        <div class="card-body py-2">
                                            <h3 class="fw-bold text-primary mb-0">@kvp.Value <span style="font-size: 1rem">người</span></h3>
                                        </div>
                                        <div class="card-footer bg-light border-0 py-1">
                                            <small class="fw-bold">@GetPoiName(kvp.Key)</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center bg-dark text-white">
                    <h4 class="mb-3 text-warning">Trạm Xe Buýt (WebApp)</h4>
                    <p class="small opacity-75 mb-4">Dán mã này tại các trạm xe buýt. Quét bằng camera để nghe WebApp mà không cần cài App.</p>
                    
                    <div class="bg-white p-3 rounded-4 d-inline-block mx-auto mb-3">
                        <img src="@qrCodeUrl" alt="QR WebApp" width="180" height="180" />
                    </div>
                    
                    <a href="@downloadLink" target="_blank" class="btn btn-warning fw-bold mt-auto">Mở Test WebApp</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardSummary summary;
    private string apiBase = "https://localhost:7008/api/Dashboard/summary";
    private string heatmapApi = "https://localhost:7008/api/Dashboard/heatmap?days=7";

    private HubConnection hubConnection;
    private int totalOnline = 0;
    private Dictionary<string, int> liveViewers = new();
    private List<PoiTemp> poiList = new();
    private List<HeatmapData> heatmapList = new();

    private string serverUrl = "https://nights-inserted-designated-expenditure.trycloudflare.com";
    private string downloadLink = "";
    private string qrCodeUrl = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        
        try { summary = await Http.GetFromJsonAsync<DashboardSummary>(apiBase); } catch { }
        try { heatmapList = await Http.GetFromJsonAsync<List<HeatmapData>>(heatmapApi); } catch { }
        try { poiList = await Http.GetFromJsonAsync<List<PoiTemp>>("https://localhost:7008/api/Pois"); } catch { }

        UpdateQR();

        hubConnection = new HubConnectionBuilder()
            .WithUrl("https://localhost:7008/travelhub?clientType=admin")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<int>("UpdateOnlineCount", (count) => { totalOnline = count; InvokeAsync(StateHasChanged); });
        hubConnection.On<string, int>("UpdateViewerCount", (poiId, count) => { liveViewers[poiId] = count; InvokeAsync(StateHasChanged); });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("RequestCurrentCounts");
    }

    private void UpdateQR()
    {
        downloadLink = $"{serverUrl.TrimEnd('/')}/web";
        qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={Uri.EscapeDataString(downloadLink)}";
        StateHasChanged();
    }

    private string GetPoiName(string id) { var p = poiList.FirstOrDefault(x => x.id.ToLower() == id.ToLower()); return p?.name ?? "Quán Ẩm Thực"; }
    public async ValueTask DisposeAsync() { if (hubConnection is not null) await hubConnection.DisposeAsync(); }

    public class DashboardSummary { public string Role { get; set; } public int TotalUsers { get; set; } public decimal TotalRevenue { get; set; } public int TotalPois { get; set; } public int TotalOrders { get; set; } public double AverageRating { get; set; } }
    public class PoiTemp { public string id { get; set; } public string name { get; set; } }
    public class HeatmapData { public string Date { get; set; } public int Count { get; set; } }
}