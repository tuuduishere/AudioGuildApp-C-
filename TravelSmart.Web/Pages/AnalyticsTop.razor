@page "/analytics-top"
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container mt-4">
    <h2>🔥 Bảng xếp hạng Địa điểm thu hút khách</h2>
    <p class="text-muted">Danh sách các quán ăn có lượt tương tác Geofence cao nhất hệ thống.</p>

    @if (topPois == null)
    {
        <div class="spinner-border text-danger"></div>
    }
    else
    {
        <div class="row mt-4">
            @for (int i = 0; i < topPois.Count; i++)
            {
                var p = topPois[i];
                <div class="col-md-12 mb-3">
                    <div class="card shadow-sm border-0 border-start border-5 @(i == 0 ? "border-danger" : "border-info")">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-1"><span class="badge bg-dark me-2">#@(i + 1)</span> @p.name</h4>
                                <p class="text-muted mb-0 small">@p.address</p>
                            </div>
                            <div class="text-end">
                                <h3 class="text-success mb-0">@p.listenCount <small class="text-muted fs-6">Lượt nghe</small></h3>
                                <p class="text-warning mb-0 fw-bold">⭐ @Math.Round(p.rating, 1)/5.0</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<TopPoiDto> topPois;
    protected override async Task OnInitializedAsync()
    {
        try { topPois = await Http.GetFromJsonAsync<List<TopPoiDto>>("https://localhost:7008/api/Analytics/top-pois"); } catch { topPois = new(); }
    }
    public class TopPoiDto { public string name { get; set; } public string address { get; set; } public int listenCount { get; set; } public double rating { get; set; } }
}