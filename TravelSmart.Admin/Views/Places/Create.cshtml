@model TravelSmart.API.Models.Place

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h4 class="mb-0"><i class="bi bi-plus-circle-fill me-2"></i>Thêm địa điểm du lịch mới</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Tên địa điểm</label>
                                <input asp-for="Name" class="form-control" placeholder="Vd: Nhà thờ Đức Bà" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Rating (1-5)</label>
                                <input asp-for="Rating" type="number" step="0.1" min="1" max="5" class="form-control" value="4.5" />
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Địa chỉ chi tiết</label>
                                <input asp-for="Address" class="form-control" placeholder="Số 1 Công xã Paris, Quận 1..." />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Vĩ độ (Latitude)</label>
                                <input asp-for="Latitude" class="form-control" id="lat" placeholder="10.779..." required />
                                <small class="text-muted">Lấy từ Google Maps</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Kinh độ (Longitude)</label>
                                <input asp-for="Longitude" class="form-control" id="lng" placeholder="106.69..." required />
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Mô tả địa điểm</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Thông tin giới thiệu về địa điểm này..."></textarea>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Hình ảnh đại diện</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">File Audio thuyết minh (.mp3)</label>
                                <input type="file" name="audioFile" class="form-control" accept="audio/*" required />
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">Lưu địa điểm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}