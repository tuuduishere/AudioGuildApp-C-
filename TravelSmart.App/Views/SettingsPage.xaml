<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.SettingsPage"
             Title="Cài đặt hệ thống"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Label Text="⚙️ Tùy chỉnh ứng dụng" FontSize="24" FontAttributes="Bold" TextColor="#1E88E5" Margin="0,0,0,10"/>

            <Frame BackgroundColor="White" CornerRadius="12" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🌐" FontSize="20" VerticalOptions="Center"/>
                        <Label Text="Ngôn ngữ thuyết minh mặc định" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Khi quét QR hoặc tới gần quán, ứng dụng sẽ tự động đọc bằng ngôn ngữ này." FontSize="12" TextColor="Gray" />

                    <Picker x:Name="PickerLanguage" Title="Chọn ngôn ngữ" SelectedIndexChanged="OnLanguageChanged" BackgroundColor="#E3F2FD" TextColor="Black" Margin="0,10,0,0">
                        <Picker.Items>
                            <x:String>🇻🇳 Tiếng Việt</x:String>
                            <x:String>🇬🇧 English (Tiếng Anh)</x:String>
                            <x:String>🇯🇵 日本語 (Tiếng Nhật)</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" CornerRadius="12" Padding="15" HasShadow="True" BorderColor="Transparent">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="🔔 Bật thông báo đẩy" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="True" OnColor="#43A047" />
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>