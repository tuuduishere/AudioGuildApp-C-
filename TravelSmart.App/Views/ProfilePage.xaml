                <Button x:Name="BtnLogin" Text="ĐĂNG NHẬP NGAY" BackgroundColor="#00838F" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="55" Clicked="OnLoginClicked" Margin="0,10,0,0" IsVisible="False" />

                <Frame x:Name="BtnLogout" BackgroundColor="White" CornerRadius="15" Padding="0" HasShadow="True" BorderColor="Transparent" Margin="0,20,0,0">
                    <Grid Padding="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                        </Grid.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Path Grid.Column="0" Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" Fill="#E53935" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Đăng xuất tài khoản" TextColor="#E53935" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" Margin="15,0,0,0"/>
