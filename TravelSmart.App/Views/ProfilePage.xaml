                    </HorizontalStackLayout>
                </Frame>

                <Frame x:Name="FrameMerchantRequest" BackgroundColor="#E0F7FA" CornerRadius="15" HasShadow="False" BorderColor="#00838F" IsVisible="True" Padding="20">
