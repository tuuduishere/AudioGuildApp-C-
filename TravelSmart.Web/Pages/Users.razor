@page "/users"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Quản lý Thành viên & Xét duyệt</h2>
        <button class="btn btn-primary fw-bold" @onclick="ToggleForm">+ Thêm Thành Viên</button>
    </div>

    @if (showForm)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white fw-bold">TẠO TÀI KHOẢN MỚI</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="fw-bold">Tên tài khoản</label>
                    <input class="form-control bg-light" @bind="newUser.Username" placeholder="Nhập username..." />
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Mật khẩu</label>
                    <input type="password" class="form-control bg-light" @bind="newUser.Password" placeholder="Nhập mật khẩu..." />
                </div>
                <div class="col-md-8">
                    <label class="fw-bold">Email</label>
                    <input type="email" class="form-control bg-light" @bind="newUser.Email" placeholder="Nhập email..." />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Cấp quyền</label>
                    <select class="form-select bg-light" @bind="newUser.RoleId">
                        <option value="3">🚶 Khách du lịch</option>
                        <option value="2">👑 Chủ quán</option>
                        <option value="1">🛑 Admin</option>
                    </select>
                </div>
                <div class="col-md-12 text-end mt-4">
                    <button class="btn btn-secondary me-2" @onclick="ToggleForm">Hủy bỏ</button>
                    <button class="btn btn-success fw-bold" @onclick="CreateUser">Lưu Tài Khoản</button>
                </div>
            </div>
        </div>
    }
    
    @if (users == null)
    {
        <div class="spinner-border text-primary"></div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr><th>Tài khoản</th><th>Email</th><th>Vai trò</th><th>Trạng thái xin Chủ quán</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr>
                                <td class="fw-bold">@u.Username</td>
                                <td>@u.Email</td>
                                <td>
                                    @if (u.RoleId != 1)
                                    {
                                        <select class="form-select form-select-sm border-primary text-primary fw-bold" @onchange="@(e => ChangeUserRole(u.UserId, e.Value.ToString()))">
                                            <option value="2" selected="@(u.RoleId == 2)">👑 Chủ quán</option>
                                            <option value="3" selected="@(u.RoleId == 3)">🚶 Khách du lịch</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                </td>
                                <td>
                                    @if (u.MerchantRequestStatus == "Pending")
                                    {
                                        <span class="badge bg-info text-dark spinner-grow spinner-grow-sm"></span>
                                        <span class="text-info fw-bold">Đang chờ...</span>
                                    }
                                    else if (u.MerchantRequestStatus == "Approved")
                                    {
                                        <span class="text-success">✔ Đã duyệt</span>
                                    }
                                    else if (u.MerchantRequestStatus == "Rejected")
                                    {
                                        <span class="text-danger">✖ Từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không có yêu cầu</span>
                                    }
                                </td>
                                <td>
                                    @if (u.MerchantRequestStatus == "Pending")
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveRequest(u.UserId)">✔ Duyệt</button>
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => RejectRequest(u.UserId)">✖ Bỏ</button>
                                    }
                                    @if (u.RoleId != 1)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUser(u.UserId)">🗑 Xóa</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<UserDto> users;
    private bool showForm = false;
    private UserCreateDto newUser = new UserCreateDto { RoleId = 3 }; // Mặc định là Khách du lịch
    private string apiBase = "https://localhost:7008/api/Users";

    protected override async Task OnInitializedAsync() { await LoadData(); }
    
    private void ToggleForm() => showForm = !showForm;

    private async Task LoadData()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        users = await Http.GetFromJsonAsync<List<UserDto>>(apiBase);
    }

    // 🔥 HÀM GỌI API TẠO THÀNH VIÊN
    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUser.Username) || string.IsNullOrWhiteSpace(newUser.Password))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng nhập đầy đủ Tên tài khoản và Mật khẩu!");
            return;
        }

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        
        var response = await Http.PostAsJsonAsync(apiBase, newUser);
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Tạo tài khoản thành công!");
            newUser = new UserCreateDto { RoleId = 3 }; // Reset form
            showForm = false;
            await LoadData();
        }
        else
        {
            var errorMsg = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Lỗi: {errorMsg}");
        }
    }

    private async Task ChangeUserRole(Guid id, string newRoleId)
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        await Http.PutAsJsonAsync($"{apiBase}/{id}/role", int.Parse(newRoleId));
        await JS.InvokeVoidAsync("alert", "Đã cập nhật quyền thành công!"); await LoadData();
    }

    private async Task ApproveRequest(Guid id) { await Http.PostAsync($"{apiBase}/{id}/approve", null); await LoadData(); }
    private async Task RejectRequest(Guid id) { await Http.PostAsync($"{apiBase}/{id}/reject", null); await LoadData(); }
    private async Task DeleteUser(Guid id) { if (await JS.InvokeAsync<bool>("confirm", "Chắc chắn xóa người dùng này?")) { await Http.DeleteAsync($"{apiBase}/{id}"); await LoadData(); } }
    
    public class UserDto { public Guid UserId { get; set; } public string Username { get; set; } public string Email { get; set; } public int RoleId { get; set; } public string MerchantRequestStatus { get; set; } public DateTime CreatedAt { get; set; } }
    
    // DTO cho Form tạo user
    public class UserCreateDto { public string Username { get; set; } public string Email { get; set; } public string Password { get; set; } public int RoleId { get; set; } }
}