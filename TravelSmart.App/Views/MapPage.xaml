<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             x:Class="TravelSmart.App.Views.MapPage"
             Title="Bản đồ">

    <Grid>

        <maps:Map x:Name="MyMap" 
          IsShowingUser="True" 
          VerticalOptions="Fill" 
          HorizontalOptions="Fill" />

        <Border BackgroundColor="{StaticResource PrimaryColor}" StrokeThickness="0" 
                VerticalOptions="Start" Padding="20,40,20,20" Margin="0,-30,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,25,25" />
            </Border.StrokeShape>
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 25" HeightRequest="50" Padding="15,0">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="🔍" VerticalOptions="Center" Grid.Column="0" FontSize="18" Margin="0,0,10,0"/>
                    <Entry Placeholder="Tìm kiếm địa điểm..." BackgroundColor="Transparent" TextColor="Black" 
                           PlaceholderColor="Gray" Grid.Column="1" VerticalOptions="Center"/>
                </Grid>
            </Border>
        </Border>

        <Button Text="Test Trượt Bottom Sheet" BackgroundColor="{StaticResource PrimaryColor}" TextColor="White" 
                VerticalOptions="Center" HorizontalOptions="End" Margin="15" CornerRadius="25" Clicked="OnTestButtonClicked"/>

        <Border x:Name="BottomSheet" BackgroundColor="White" StrokeThickness="0" 
                VerticalOptions="End" Padding="20" Margin="10,0,10,10" 
                TranslationY="300" Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,20,20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="10" Opacity="0.2" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto">
                <Border BackgroundColor="#F0EEFF" StrokeThickness="0" StrokeShape="RoundRectangle 10" 
                        WidthRequest="60" HeightRequest="60" Grid.Column="0" Margin="0,0,15,0">
                    <Label Text="📍" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Halaç etraby" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="Tôi là yoshikage kira năm nay 33 tuổi" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation"/>
                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                        <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="6,2">
                            <Label Text="Khác" FontSize="10" TextColor="{StaticResource PrimaryColor}"/>
                        </Border>
                        <Label Text="Ưu tiên 1" FontSize="11" TextColor="Gray" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Image Source="dotnet_bot.png" WidthRequest="30" HeightRequest="30" Grid.Column="2" VerticalOptions="Center" Opacity="0.5"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>