<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.POIListView">

    <Grid RowDefinitions="Auto, *">
        <Frame Grid.Row="0" Margin="20,10" Padding="15,0" HeightRequest="50" 
               CornerRadius="25" HasShadow="False" BackgroundColor="White">
            <HorizontalStackLayout VerticalOptions="Center">
                <Image Source="search_icon.png" WidthRequest="20" Margin="0,0,10,0" Opacity="0.5"/>
                <Label Text="Tìm kiếm địa điểm..." VerticalOptions="Center" TextColor="Gray" />
            </HorizontalStackLayout>
        </Frame>

        <CollectionView Grid.Row="1" ItemsSource="{Binding PoiList}" Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="15" CornerRadius="15" HasShadow="True" BorderColor="#EEEEEE">
                        <HorizontalStackLayout Spacing="15">
                            <Frame WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0" 
                                   BackgroundColor="#FFF8E1" BorderColor="Transparent">
                                <Label Text="🐚" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24"/>
                            </Frame>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="#333333"/>
                                <Label Text="{Binding Description}" FontSize="14" TextColor="Gray" MaxLines="1" LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                    <Label Text="{Binding QrCodeKey}" FontSize="11" TextColor="#FFC107" FontAttributes="Bold"/>
                                    <Label Text="•" TextColor="Silver"/>
                                    <Label Text="Đang mở cửa" FontSize="11" TextColor="Green"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>