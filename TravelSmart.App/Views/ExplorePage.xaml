<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.ExplorePage">

    <VerticalStackLayout Padding="10">
        <SearchBar x:Name="searchBar" Placeholder="Tìm ở TP.HCM..." TextChanged="OnSearch"/>

        <CollectionView x:Name="listView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#1A73E8" StrokeThickness="1" Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Image Source="{Binding Image}" HeightRequest="140" />
                            <Label Text="{Binding Name}" FontSize="18" />
                            <Label Text="⭐ {Binding Rating}" />
                            <Label Text="{Binding Price}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
