<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.FoodPage">

    <VerticalStackLayout Padding="10">

        <Picker Title="Lọc món" SelectedIndexChanged="OnFilter">
            <Picker.Items>
                <x:String>All</x:String>
                <x:String>Cơm</x:String>
                <x:String>Nước</x:String>
                <x:String>Nhanh</x:String>
            </Picker.Items>
        </Picker>

        <CollectionView x:Name="foodList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="Gray" StrokeThickness="1" Padding="10" Margin="5">
                        <HorizontalStackLayout>
                            <Image Source="{Binding Image}" WidthRequest="80" />
                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>