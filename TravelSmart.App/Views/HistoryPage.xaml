<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.HistoryPage"
             Title="Nhật ký tham quan">
    <CollectionView x:Name="ListHistory" Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BorderColor="#E0E0E0" CornerRadius="10" Margin="0,5" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="#2196F3"/>
                        <Label Text="{Binding VisitTime, StringFormat='Đã ghé thăm: {0:dd/MM/yyyy HH:mm}'}" FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>