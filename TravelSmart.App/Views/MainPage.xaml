<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="TravelSmart.App.Views.MainPage"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <Grid RowDefinitions="*, Auto">
            <Grid Grid.Row="0">
                <maps:Map x:Name="MyMap" IsShowingUser="True" />

                <Grid Margin="15,40,15,0" VerticalOptions="Start" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Frame Grid.Column="0" Padding="5,0" CornerRadius="25" HasShadow="True" BackgroundColor="White" HeightRequest="50" BorderColor="Transparent">
                        <SearchBar x:Name="SearchPoi" Placeholder="🔍 Tìm quán ốc, lẩu..." BackgroundColor="Transparent" SearchButtonPressed="OnSearchButtonPressed" TextChanged="OnSearchTextChanged" />
                    </Frame>

                    <Grid Grid.Column="1" WidthRequest="50" HeightRequest="50">
                        <Frame Padding="0" CornerRadius="25" HasShadow="True" BackgroundColor="White" BorderColor="Transparent">
                            <Label Text="🔔" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>
                        <Frame x:Name="BadgeNoti" BackgroundColor="Red" CornerRadius="10" HeightRequest="20" WidthRequest="20" Padding="0" HasShadow="False" HorizontalOptions="End" VerticalOptions="Start" TranslationX="5" TranslationY="-5" IsVisible="False">
                            <Label x:Name="LblUnreadCount" Text="0" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Grid>
            </Grid>

            <Frame Grid.Row="1" Padding="0" HeightRequest="70" BackgroundColor="White" HasShadow="True" CornerRadius="0" BorderColor="#E0E0E0">
                <Grid ColumnDefinitions="*, *, *, *">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRefreshMapClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="📍" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="Bản đồ" FontSize="10" HorizontalOptions="Center" TextColor="#2196F3"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScanClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="📷" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="Quét mã" FontSize="10" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="📜" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="Lịch sử" FontSize="10" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="👤" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="Tôi" FontSize="10" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </Grid>

        <BoxView x:Name="SheetOverlay" BackgroundColor="Black" Opacity="0" InputTransparent="True" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CloseBottomSheet" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Frame x:Name="BottomSheet" BackgroundColor="White" CornerRadius="30" HasShadow="True" VerticalOptions="End" HeightRequest="650" TranslationY="700" Padding="0">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Padding="20,15,20,10" BackgroundColor="#FAFAFA">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label x:Name="LblPoiName" Text="Tên Quán" FontSize="20" FontAttributes="Bold" TextColor="#1E88E5" />
                        <Label x:Name="LblPoiAddress" Text="Địa chỉ quán" FontSize="12" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="🗺 Đi ngay" BackgroundColor="#43A047" TextColor="White" CornerRadius="8" FontAttributes="Bold" HeightRequest="40" Padding="10,0" Margin="10,0" Clicked="OnGetDirectionsClicked" />
                </Grid>
                <BoxView Grid.Row="1" HeightRequest="1" Color="#EEEEEE" />
                <ScrollView Grid.Row="2" Padding="20">
                    <VerticalStackLayout Spacing="25">
                        <VerticalStackLayout>
                            <HorizontalStackLayout Spacing="5" Margin="0,0,0,10">
                                <Label Text="🍽" FontSize="18"/>
                                <Label Text="THỰC ĐƠN" FontAttributes="Bold" FontSize="16" TextColor="#D32F2F" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <VerticalStackLayout x:Name="ContainerMenu" Spacing="5" />
                        </VerticalStackLayout>

                        <Frame x:Name="FrameWriteReview" BackgroundColor="#F3E5F5" CornerRadius="10" Padding="15" BorderColor="Transparent" IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Viết đánh giá của bạn" FontAttributes="Bold" TextColor="#8E24AA"/>
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="Chấm điểm:" VerticalOptions="Center"/>
                                    <Stepper x:Name="StepperRating" Minimum="1" Maximum="5" Increment="1" Value="5" />
                                    <Label Text="{Binding Source={x:Reference StepperRating}, Path=Value, StringFormat='{0} Sao ⭐'}" FontAttributes="Bold" TextColor="#FFA000" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Entry x:Name="EntryReview" Placeholder="Nhập bình luận..." BackgroundColor="White" />
                                <Button Text="GỬI ĐÁNH GIÁ" BackgroundColor="#8E24AA" TextColor="White" CornerRadius="8" Clicked="OnSubmitReviewClicked" />
                            </VerticalStackLayout>
                        </Frame>

                        <VerticalStackLayout>
                            <HorizontalStackLayout Spacing="5" Margin="0,0,0,10">
                                <Label Text="⭐" FontSize="18"/>
                                <Label Text="ĐÁNH GIÁ GẦN ĐÂY" FontAttributes="Bold" FontSize="16" TextColor="#388E3C" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <VerticalStackLayout x:Name="ContainerReviews" Spacing="10" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>