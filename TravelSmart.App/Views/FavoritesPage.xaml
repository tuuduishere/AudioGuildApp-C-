<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.FavoritesPage">

    <VerticalStackLayout Padding="12" Spacing="8">
        <Label Text="Yêu thích" FontSize="22" FontAttributes="Bold" />
        <CollectionView x:Name="favList" ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}">
                        <HorizontalStackLayout Spacing="12">
                            <Image Source="{Binding Image}" WidthRequest="72" HeightRequest="72" Aspect="AspectFill" />
                            <VerticalStackLayout VerticalOptions="CenterAndExpand">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                <Label Text="⭐ {Binding Rating} • {Binding Price}" Style="{StaticResource CardSubtitle}" />
                            </VerticalStackLayout>
                            <Button Text="Mở" Clicked="OnOpen" HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
