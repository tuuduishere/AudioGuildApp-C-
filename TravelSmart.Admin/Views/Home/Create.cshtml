@model TravelSmart.Admin.Models.PoiViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Thêm Quán Mới</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5 p-4 bg-white shadow rounded" style="max-width: 800px;">
        <h3 class="mb-4 text-success">➕ Thêm Địa Điểm (POI) Mới</h3>
        
        <form method="post" action="/Home/Create" class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Tên Quán Ốc</label>
                <input type="text" name="Name" class="form-control" placeholder="VD: Ốc Oanh" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Mã QR</label>
                <input type="text" name="QrCodeKey" class="form-control" placeholder="VD: VK_OC_OANH" required />
            </div>
            <div class="col-md-12">
                <label class="form-label fw-bold">Mô tả ngắn</label>
                <input type="text" name="Description" class="form-control" placeholder="Quán ốc ngon nhất nhì Vĩnh Khánh..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Vĩ độ (Latitude)</label>
                <input type="number" step="any" name="Latitude" class="form-control" value="10.7600" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Kinh độ (Longitude)</label>
                <input type="number" step="any" name="Longitude" class="form-control" value="106.7050" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Bán kính quét (mét)</label>
                <input type="number" name="Radius" class="form-control" value="50" />
            </div>
            <div class="col-md-12">
                <label class="form-label fw-bold">Nội dung Thuyết minh (AI sẽ đọc)</label>
                <textarea name="TtsContent" class="form-control" rows="3" placeholder="Chào mừng bạn đến với..." required></textarea>
            </div>
            <div class="col-12 mt-4 text-end">
                <a href="/Home/Index" class="btn btn-secondary me-2">Hủy Bỏ</a>
                <button type="submit" class="btn btn-primary fw-bold">💾 Lưu Dữ Liệu</button>
            </div>
        </form>
    </div>
</body>
</html>