<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.TourListPage"
             Title="Danh sách Tuyến đi"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="#00838F" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center">
                    <Path.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseClicked" />
                    </Path.GestureRecognizers>
                </Path>
                <Label Text="Bản đồ Tuyến đi" FontSize="26" FontAttributes="Bold" TextColor="#00838F" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Khám phá các tour ẩm thực, di tích nổi bật nhất được thiết kế dành riêng cho bạn." TextColor="Gray" FontSize="14" Margin="39,0,0,0" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="RefreshTours" Refreshing="OnRefreshTours">
            <CollectionView x:Name="ListTours" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,15" Padding="20" CornerRadius="15" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=SelectTourCommand}" CommandParameter="{Binding TourId}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                                <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#006064" />
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Frame Grid.Column="1" BackgroundColor="#E0F7FA" CornerRadius="12" Padding="10" HasShadow="False" BorderColor="Transparent" VerticalOptions="Center">
                                    <Path Data="M15,21L10.5,19.5L4.5,21.5V5L9,3.5L13.5,5L19.5,3.5V20L15,21M14,5.89L10,4.56V18.11L14,19.44V5.89Z" Fill="#00838F" Aspect="Uniform" HeightRequest="28" WidthRequest="28" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Đang tải danh sách tuyến đi..." HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" FontAttributes="Italic"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" Text="Hiển thị toàn bộ bản đồ" BackgroundColor="#EEEEEE" TextColor="#333333" FontAttributes="Bold" CornerRadius="10" HeightRequest="55" Margin="0,10,0,0" Clicked="OnClearFilterClicked" />

    </Grid>
</ContentPage>