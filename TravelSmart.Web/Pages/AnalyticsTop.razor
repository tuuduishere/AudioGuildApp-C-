@page "/analytics-top"
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container mt-4">
    <h2>🔥 Bảng xếp hạng Địa điểm (Top POIs)</h2>
    <p class="text-muted">Phân tích các quán ăn, địa điểm thu hút lượng khách tương tác cao nhất.</p>

    @if (topPois == null)
    {
        <div class="spinner-border text-danger mt-3"></div>
    }
    else
    {
        <div class="row mt-4">
            @for (int i = 0; i < topPois.Count; i++)
            {
                var p = topPois[i];
                <div class="col-md-12 mb-3">
                    <div class="card shadow-sm border-0 border-start border-5 @(i == 0 ? "border-danger" : (i == 1 ? "border-warning" : "border-info"))">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-1">
                                    <span class="badge @(i == 0 ? "bg-danger" : (i == 1 ? "bg-warning text-dark" : "bg-info text-dark")) me-2">#@(i + 1)</span>
                                    @p.Name
                                </h4>
                                <p class="text-muted mb-0 small">@p.Address</p>
                            </div>
                            <div class="text-end">
                                <h3 class="text-success mb-0">@p.ListenCount <small class="text-muted fs-6">Lượt nghe</small></h3>
                                <p class="text-warning mb-0 fw-bold">⭐ @p.Rating/5.0</p>
                            </div>
                        </div>
                        <div class="progress" style="height: 5px; border-radius: 0 0 5px 5px;">
                            <div class="progress-bar @(i == 0 ? "bg-danger" : (i == 1 ? "bg-warning" : "bg-info"))" role="progressbar" style="width: @(p.ListenCount * 100 / topPois[0].ListenCount)%"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<TopPoiDto> topPois;
    private string apiBase = "https://localhost:7008/api/Pois";

    protected override async Task OnInitializedAsync()
    {
        var rawData = await Http.GetFromJsonAsync<List<Dictionary<string, object>>>(apiBase);
        var r = new Random();
        
        topPois = rawData.Select(d => new TopPoiDto
        {
            Name = d["name"].ToString(),
            Address = d.ContainsKey("address") && d["address"] != null ? d["address"].ToString() : "Đang cập nhật",
            ListenCount = r.Next(50, 500),
            Rating = Math.Round(r.NextDouble() * (5.0 - 3.5) + 3.5, 1) // Random từ 3.5 đến 5.0
        })
        .OrderByDescending(x => x.ListenCount)
        .Take(10)
        .ToList();
    }

    public class TopPoiDto { public string Name { get; set; } public string Address { get; set; } public int ListenCount { get; set; } public double Rating { get; set; } }
}