@page "/analytics-history"
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container mt-4">
    <h2>🕒 Lịch sử Khách hàng sử dụng App</h2>
    <p class="text-muted">Dữ liệu thật được đồng bộ trực tiếp từ thiết bị người dùng khi đi vào vùng Geofence.</p>

    @if (historyLogs == null)
    {
        <div class="d-flex align-items-center">
            <div class="spinner-border text-primary me-2"></div>
            <strong>Đang bốc dữ liệu từ database...</strong>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 mt-3">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Thời gian</th>
                            <th>Thiết bị</th>
                            <th>Địa điểm (POI)</th>
                            <th>Thời gian nghe</th>
                            <th>Ngôn ngữ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in historyLogs)
                        {
                            <tr>
                                <td>@log.time</td>
                                <td><span class="badge bg-secondary">@log.device</span></td>
                                <td class="fw-bold text-primary">@log.poiName</td>
                                <td class="text-success fw-bold">@log.duration phút</td>
                                <td>@log.language</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<LogDto> historyLogs;
    protected override async Task OnInitializedAsync()
    {
        try { historyLogs = await Http.GetFromJsonAsync<List<LogDto>>("https://localhost:7008/api/Analytics/logs"); } catch { historyLogs = new(); }
    }
    public class LogDto { public string time { get; set; } public string device { get; set; } public string poiName { get; set; } public double duration { get; set; } public string language { get; set; } }
}