@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid"><a class="navbar-brand" href="">TravelSmart Admin</a></div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        @if (!string.IsNullOrEmpty(role))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">📊 Tổng quan</NavLink>
            </div>
            
            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-info fw-bold">HỆ THỐNG CMS</h6>
            
            <div class="nav-item px-3"><NavLink class="nav-link" href="pois">🏪 Quản lý POI</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="audios">🎵 Audio & Bản dịch</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="tours">🗺️ Quản lý Tour tuyến</NavLink></div>

            @if (role == "Admin")
            {
                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-warning fw-bold">PHÂN TÍCH (ANALYTICS)</h6>
                <div class="nav-item px-3"><NavLink class="nav-link" href="analytics-history">🕒 Lịch sử sử dụng</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="analytics-top">🔥 Top địa điểm nghe</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="analytics-heatmap">📍 Heatmap & Tuyến đi</NavLink></div>

                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-light fw-bold">TÀI KHOẢN</h6>
                <div class="nav-item px-3"><NavLink class="nav-link" href="users">👥 Quản lý Thành viên</NavLink></div>
            }

            <div class="nav-item px-3 mt-5">
                <button class="nav-link btn btn-link text-danger w-100 text-start fw-bold" @onclick="HandleLogout" style="border: none; outline: none; box-shadow: none;">
                    🚪 Đăng xuất
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private string role = "";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { role = await JS.InvokeAsync<string>("localStorage.getItem", "userRole"); StateHasChanged(); }
    }
    private async Task HandleLogout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userRole");
        Nav.NavigateTo("/login", true);
    }
}