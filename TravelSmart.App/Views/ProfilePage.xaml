<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.ProfilePage"
             Title="Cá nhân"
             BackgroundColor="#F5F5F5">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙️" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20" BorderColor="Transparent">
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Frame WidthRequest="70" HeightRequest="70" CornerRadius="35" BackgroundColor="#E0E0E0" Padding="0" IsClippedToBounds="True">
                        <Label Text="👤" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label x:Name="LblUsername" Text="Đang tải..." FontSize="20" FontAttributes="Bold" TextColor="Black" />
                        <Label x:Name="LblRole" Text="Thành viên" FontSize="14" TextColor="Gray" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <Frame x:Name="FrameMerchantRequest" BackgroundColor="#E3F2FD" CornerRadius="15" HasShadow="False" BorderColor="#2196F3" IsVisible="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🏪 Hợp tác cùng TravelSmart" FontSize="18" FontAttributes="Bold" TextColor="#1976D2" />
                    <Label Text="Đưa quán ăn của bạn lên bản đồ và quản lý doanh thu dễ dàng." TextColor="#1565C0" FontSize="14" />
                    <Button Text="ĐĂNG KÝ LÀM CHỦ QUÁN" BackgroundColor="#2196F3" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0" Clicked="OnRequestMerchantClicked" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Đăng xuất" BackgroundColor="#FFEBEE" TextColor="#D32F2F" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="OnLogoutClicked" Margin="0,30,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>