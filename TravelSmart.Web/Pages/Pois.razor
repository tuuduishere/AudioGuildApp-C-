@page "/pois"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="container mt-4 position-relative">
    @if (string.IsNullOrEmpty(selectedPoiId))
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>🏪 Quản lý Quán ăn</h2>
            @if (userRole == "Merchant")
            {
                <button class="btn btn-primary fw-bold" @onclick="ToggleForm">+ Thêm Quán Mới</button>
            }
        </div>

        @if (showForm && userRole == "Merchant")
        {
            <div class="card shadow-sm mb-4 border-primary">
                <div class="card-header bg-primary text-white fw-bold">NHẬP THÔNG TIN QUÁN</div>
                <div class="card-body row g-3">
                    
                    <div class="col-md-12"><input class="form-control" @bind="newPoi.Name" placeholder="Tên quán (VD: Ốc Oanh)" /></div>
                    
                    <div class="col-md-12 position-relative">
                        <label class="fw-bold text-primary mb-1">🔍 Tìm địa chỉ trên Bản đồ:</label>
                        <div class="input-group">
                            <input class="form-control border-primary" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" placeholder="Nhập địa chỉ (VD: Chợ Bến Thành)..." />
                            <button class="btn btn-warning fw-bold" type="button" @onclick="SearchAddress">Tìm Tọa Độ</button>
                        </div>
                        
                        @if (addressSuggestions != null && addressSuggestions.Any())
                        {
                            <ul class="list-group position-absolute w-100 shadow-lg" style="z-index: 1000; top: 100%;">
                                @foreach (var s in addressSuggestions)
                                {
                                    <li class="list-group-item list-group-item-action" style="cursor: pointer;" @onclick="() => SelectAddress(s)">
                                        📍 @s.display_name
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="col-md-12"><input class="form-control bg-light" @bind="newPoi.Address" placeholder="Địa chỉ chi tiết..." /></div>
                    <div class="col-md-5"><input class="form-control bg-light" @bind="newPoi.Latitude" placeholder="Vĩ độ (Latitude)" type="number" /></div>
                    <div class="col-md-5"><input class="form-control bg-light" @bind="newPoi.Longitude" placeholder="Kinh độ (Longitude)" type="number" /></div>
                    
                    <div class="col-md-2">
                        <button class="btn btn-info w-100 fw-bold text-white" type="button" @onclick="GetMyLocation">📍 Lấy vị trí GPS</button>
                    </div>

                    <div class="col-md-12"><textarea class="form-control" @bind="newPoi.Description" placeholder="Mô tả quán..."></textarea></div>
                    <div class="col-md-12 text-end">
                        <button class="btn btn-secondary me-2" @onclick="ToggleForm">Hủy</button>
                        <button class="btn btn-success fw-bold" @onclick="SavePoi">Lưu Quán</button>
                    </div>
                </div>
            </div>
        }

        @if (listPois == null)
        {
            <div class="spinner-border text-primary"></div>
        }
        else
        {
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr><th>Tên Quán</th><th>Địa chỉ</th><th>Thao tác</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in listPois)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@p.Name</td>
                                    <td>@p.Address</td>
                                    <td>
                                        <button class="btn btn-sm btn-info text-dark fw-bold me-1" @onclick="() => ShowQrModal(p.QrCodeKey, p.Name)">📱 Xem QR</button>
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => ViewPoiDetails(p.Id, p.Name)">📝 Menu</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePoi(p.Id)">🗑 Xóa</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>🍽 Quản lý: <span class="text-primary">@selectedPoiName</span></h2>
            <button class="btn btn-secondary fw-bold" @onclick="CloseDetails">⬅ Quay lại</button>
        </div>

        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-warning fw-bold text-dark">THỰC ĐƠN (MENU)</div>
                    <div class="card-body">
                        @if (userRole == "Merchant")
                        {
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" placeholder="Tên món..." @bind="newItem.ItemName">
                                    <input type="number" class="form-control" placeholder="Giá tiền..." @bind="newItem.Price">
                                        <button class="btn btn-primary" type="button" @onclick="AddMenuItem">+ Thêm món</button>
                                    </div>
                                }
                                <table class="table table-sm">
                                    <thead><tr><th>Tên món</th><th>Giá bán</th><th></th></tr></thead>
                                    <tbody>
                                        @if (poiDetails?.Menu != null)
                                        {
                                            foreach (var m in poiDetails.Menu)
                                            {
                                                <tr>
                                                    <td class="fw-bold">@m.ItemName</td>
                                                    <td class="text-success">@m.Price.ToString("N0") đ</td>
                                                    <td class="text-end">
                                                        @if (userRole == "Merchant")
                                                        {
                                                            <button class="btn btn-sm btn-danger py-0" @onclick="() => DeleteMenuItem(m.ItemId)">X</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-success fw-bold text-white">ĐÁNH GIÁ TỪ KHÁCH HÀNG</div>
                            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                                @if (poiDetails?.Reviews != null && poiDetails.Reviews.Count > 0)
                                {
                                    foreach (var r in poiDetails.Reviews)
                                    {
                                        <div class="mb-3 border-bottom pb-2">
                                            <div class="text-warning fw-bold">@for (int i = 0; i < r.Rating; i++) {
                                                <span>⭐</span>
                                            }
                                        </div>
                                        <div class="fst-italic">"@r.Comment"</div>
                                        <small class="text-muted">Gửi lúc: @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                }
                            }
                        else
                            {

                                <p class="text-muted">Chưa có đánh giá nào.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (isQrModalOpen)
        {
            <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6);" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-4 shadow-lg">
                        <div class="modal-header bg-dark text-white border-0 rounded-top-4">
                            <h5 class="modal-title fw-bold">QR Code: @currentQrPoiName</h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseQrModal"></button>
                        </div>
                        <div class="modal-body text-center p-4">
                            <img src="@currentQrUrl" alt="QR Code" class="img-fluid border border-3 rounded-3 mb-3 p-2" style="max-width: 250px;" />
                            <p class="text-muted small">Khách hàng quét mã này bằng <strong>TravelSmart App</strong> để nghe thuyết minh và xem Menu!</p>
                        </div>
                        <div class="modal-footer border-0 justify-content-center">
                            <button class="btn btn-secondary fw-bold px-4" @onclick="CloseQrModal">Đóng</button>
                            <button class="btn btn-success fw-bold px-4" @onclick="DownloadQrCode">📥 Tải Ảnh Về</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

@code {
    private List<PoiDto> listPois;
    private PoiCreateDto newPoi = new();
    private bool showForm = false;
    private string userRole = "";
    private string apiBase = "https://localhost:7008/api/Pois";
    
    // Biến cho màn hình Chi tiết
    private string selectedPoiId = "";
    private string selectedPoiName = "";
    private PoiDetailDto poiDetails = new();
    private MenuItemCreateDto newItem = new();

    // Biến cho tính năng Tìm địa chỉ (OpenStreetMap)
    private string searchQuery = "";
    private List<OSMResult> addressSuggestions = new();

    // Biến cho Modal QR Code
    private bool isQrModalOpen = false;
    private string currentQrUrl = "";
    private string currentQrPoiName = "";

    protected override async Task OnInitializedAsync()
    {
        userRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
        await LoadData();
    }

    private void ToggleForm() => showForm = !showForm;
    private void CloseDetails() { selectedPoiId = ""; selectedPoiName = ""; }

    private async Task LoadData()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var rawData = await Http.GetFromJsonAsync<List<Dictionary<string, object>>>(apiBase);
        listPois = rawData.Select(d => new PoiDto
        {
            Id = d["id"].ToString(),
            Name = d["name"].ToString(),
            Address = d.ContainsKey("address") && d["address"] != null ? d["address"].ToString() : "Đang cập nhật",
            QrCodeKey = d["qrCodeKey"]?.ToString() ?? "Trống"
        }).ToList();
    }

    // --- TÍNH NĂNG TÌM ĐỊA CHỈ (NOMINATIM API) ---
    private async Task HandleSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchAddress(); }

    private async Task SearchAddress()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        try
        {
            using var client = new HttpClient();
            client.DefaultRequestHeaders.Add("User-Agent", "TravelSmartApp/1.0"); // Bắt buộc phải có để API free không chặn
            var url = $"https://nominatim.openstreetmap.org/search?format=json&q={Uri.EscapeDataString(searchQuery)}&limit=5";
            addressSuggestions = await client.GetFromJsonAsync<List<OSMResult>>(url);
        }
        catch { }
    }

    private void SelectAddress(OSMResult result)
    {
        newPoi.Address = result.display_name;
        newPoi.Latitude = double.Parse(result.lat, System.Globalization.CultureInfo.InvariantCulture);
        newPoi.Longitude = double.Parse(result.lon, System.Globalization.CultureInfo.InvariantCulture);
        addressSuggestions.Clear(); // Ẩn gợi ý
    }

    // --- TÍNH NĂNG XEM VÀ TẢI QR CODE ---
    private void ShowQrModal(string qrKey, string poiName)
    {
        currentQrPoiName = poiName;
        // Sử dụng API tạo QR Code miễn phí
        currentQrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={qrKey}";
        isQrModalOpen = true;
    }
    private void CloseQrModal() => isQrModalOpen = false;

    private async Task DownloadQrCode()
    {
        string safeFileName = currentQrPoiName.Replace(" ", "_") + "_QRCode.png";
        // Gọi hàm JS bên index.html để tải
        await JS.InvokeVoidAsync("downloadFileFromUrl", currentQrUrl, safeFileName);
    }

    // Lấy GPS thủ công (Giữ nguyên)
    private async Task GetMyLocation()
    {
        try
        {
            var jsCode = @"return new Promise((resolve, reject) => { navigator.geolocation.getCurrentPosition(pos => resolve(pos.coords.latitude + ',' + pos.coords.longitude), err => resolve('error')); });";
            var result = await JS.InvokeAsync<string>("eval", jsCode);
            if (result != "error")
            {
                var coords = result.Split(',');
                newPoi.Latitude = double.Parse(coords[0], System.Globalization.CultureInfo.InvariantCulture);
                newPoi.Longitude = double.Parse(coords[1], System.Globalization.CultureInfo.InvariantCulture);
            }
            else await JS.InvokeVoidAsync("alert", "Hãy cho phép trình duyệt truy cập Vị trí (Location) nhé!");
        }
        catch { }
    }

    private async Task SavePoi()
    {
        if (string.IsNullOrEmpty(newPoi.Name)) return;
        newPoi.QrCodeKey = "QR_" + DateTime.Now.Ticks.ToString().Substring(10);
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var response = await Http.PostAsJsonAsync(apiBase, newPoi);
        if (response.IsSuccessStatusCode) { newPoi = new PoiCreateDto(); showForm = false; await LoadData(); }
    }

    private async Task DeletePoi(string id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Xóa quán này sẽ bay luôn cả Menu và Đánh giá. Chắc chưa?"))
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            await Http.DeleteAsync($"{apiBase}/{id}"); await LoadData();
        }
    }

    // --- CÁC HÀM XỬ LÝ CHI TIẾT QUÁN (MENU) ---
    private async Task ViewPoiDetails(string id, string name) { selectedPoiId = id; selectedPoiName = name; await LoadPoiDetails(); }

    private async Task LoadPoiDetails()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        poiDetails = await Http.GetFromJsonAsync<PoiDetailDto>($"{apiBase}/{selectedPoiId}");
    }

    private async Task AddMenuItem()
    {
        if (string.IsNullOrEmpty(newItem.ItemName) || newItem.Price <= 0) return;
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var response = await Http.PostAsJsonAsync($"{apiBase}/{selectedPoiId}/menu", newItem);
        if (response.IsSuccessStatusCode) { newItem = new MenuItemCreateDto(); await LoadPoiDetails(); }
    }

    private async Task DeleteMenuItem(string itemId)
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        await Http.DeleteAsync($"{apiBase}/menu/{itemId}"); await LoadPoiDetails();
    }

    // --- CÁC CLASS DỮ LIỆU ---
    public class OSMResult { public string display_name { get; set; } public string lat { get; set; } public string lon { get; set; } }
    public class PoiDto { public string Id { get; set; } public string Name { get; set; } public string Address { get; set; } public string QrCodeKey { get; set; } }
    public class PoiCreateDto { public string Name { get; set; } public string Address { get; set; } public double Latitude { get; set; } public double Longitude { get; set; } public string Description { get; set; } public string QrCodeKey { get; set; } }
    public class MenuItemCreateDto { public string ItemName { get; set; } public decimal Price { get; set; } }
    public class PoiDetailDto { public List<MenuItemDto> Menu { get; set; } public List<ReviewDto> Reviews { get; set; } }
    public class MenuItemDto { public string ItemId { get; set; } public string ItemName { get; set; } public decimal Price { get; set; } }
    public class ReviewDto { public int Rating { get; set; } public string Comment { get; set; } public DateTime CreatedAt { get; set; } }
}