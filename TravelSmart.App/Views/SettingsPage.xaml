<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.SettingsPage"
             Title="Cài đặt hệ thống"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="20">

            <Label Text="🎧 ÂM THANH &amp; NGÔN NGỮ" FontSize="14" FontAttributes="Bold" TextColor="Gray" Margin="5,0,0,-10"/>
            <Frame BackgroundColor="White" CornerRadius="15" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ngôn ngữ thuyết minh mặc định" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                        <Label Text="Tự động đọc bằng ngôn ngữ này khi tới quán." FontSize="12" TextColor="Gray" />
                        <Picker x:Name="PickerLanguage" Title="Chọn ngôn ngữ" SelectedIndexChanged="OnLanguageChanged" BackgroundColor="#E3F2FD" TextColor="Black">
                            <Picker.Items>
                                <x:String>🇻🇳 Tiếng Việt</x:String>
                                <x:String>🇬🇧 English (Tiếng Anh)</x:String>
                                <x:String>🇯🇵 日本語 (Tiếng Nhật)</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EEEEEE"/>

                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Tốc độ giọng đọc AI:" FontAttributes="Bold" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                            <Label x:Name="LblSpeedValue" Text="1.0x" FontAttributes="Bold" TextColor="#1E88E5" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Text="Chỉnh tốc độ nói nhanh hoặc chậm hơn." FontSize="12" TextColor="Gray" />
                        <Slider x:Name="SliderTtsSpeed" Minimum="0.5" Maximum="2.0" Value="1.0" MinimumTrackColor="#1E88E5" MaximumTrackColor="#BBDEFB" ValueChanged="OnSpeedSliderChanged"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Label Text="📍 ĐỊNH VỊ &amp; BẢN ĐỒ" FontSize="14" FontAttributes="Bold" TextColor="Gray" Margin="5,0,0,-10"/>
            <Frame BackgroundColor="White" CornerRadius="15" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="5">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Bán kính tự động kích hoạt:" FontAttributes="Bold" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                        <Label x:Name="LblRadiusValue" Text="50m" FontAttributes="Bold" TextColor="#43A047" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="App sẽ tự phát âm thanh khi bạn bước vào vùng này." FontSize="12" TextColor="Gray" />
                    <Slider x:Name="SliderRadius" Minimum="20" Maximum="200" Value="50" MinimumTrackColor="#43A047" MaximumTrackColor="#C8E6C9" ValueChanged="OnRadiusSliderChanged"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="💾 DỮ LIỆU &amp; LƯU TRỮ OFFLINE" FontSize="14" FontAttributes="Bold" TextColor="Gray" Margin="5,0,0,-10"/>
            <Frame BackgroundColor="White" CornerRadius="15" Padding="0" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout>
                    <Grid Padding="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSyncDataClicked"/>
                        </Grid.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="🔄" FontSize="20" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="Cập nhật dữ liệu mới nhất" TextColor="Black" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="Tải thông tin quán ăn và bản dịch mới." TextColor="Gray" FontSize="12"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text=">" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EEEEEE"/>

                    <Grid Padding="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearCacheClicked"/>
                        </Grid.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="🗑️" FontSize="20" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="Xóa bộ nhớ đệm âm thanh" TextColor="#D32F2F" FontSize="16" FontAttributes="Bold"/>
                                <Label x:Name="LblCacheSize" Text="Đang chiếm: 0 MB" TextColor="Gray" FontSize="12"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" CornerRadius="15" Padding="15" HasShadow="True" BorderColor="Transparent" Margin="0,0,0,30">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="🔔 Thông báo đẩy" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                        <Label Text="Nhận tin tức ưu đãi từ các quán ăn." FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="True" OnColor="#43A047" VerticalOptions="Center"/>
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>