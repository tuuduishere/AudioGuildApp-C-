<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.0.1" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.51" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference to TravelSmart.API removed temporarily because the project file is missing in the workspace.
         Restore this reference if TravelSmart.API is added back to the solution. -->
  </ItemGroup>

  <!-- Prevent building server-side admin code in this workspace (API project missing) -->
  <ItemGroup>
    <!-- Exclude controllers and views from compilation so solution can build for the MAUI app -->
    <Compile Remove="Controllers\**\*.cs" />
    <Content Remove="Views\**\*" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Disable Razor compilation to avoid errors while API project is missing -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
