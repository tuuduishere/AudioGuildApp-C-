<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.Views.HistoryView"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="5">
            <Label Text="⏱ Lịch sử tham quan" FontSize="22" FontAttributes="Bold" TextColor="#FF6700"/>
            <Label Text="Những nơi bạn đã từng ghé thăm" FontSize="13" TextColor="Gray"/>
            <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,10,0,0"/>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="EmptyStateView" Grid.Row="1" 
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
            <Label Text="🐚" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="Chưa có hành trình nào" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>
            <Label Text="Hãy đi dạo phố ốc Vĩnh Khánh để ghi lại những kỷ niệm nhé!" 
                   TextColor="Gray" HorizontalTextAlignment="Center" WidthRequest="250"/>
        </VerticalStackLayout>

        <CollectionView x:Name="HistoryList" Grid.Row="1" IsVisible="False" Margin="15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="12" HasShadow="False" BorderColor="#F0F0F0" 
                           Padding="12" Margin="0,0,0,10" BackgroundColor="#FAFAFA">
                        <Grid ColumnDefinitions="50, *" ColumnSpacing="10">
                            <Frame Grid.Column="0" CornerRadius="25" HeightRequest="50" WidthRequest="50" 
                                   Padding="0" BackgroundColor="#FFF0E6" BorderColor="Transparent">
                                <Label Text="📍" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding PoiName}" FontAttributes="Bold" FontSize="16" TextColor="#333333"/>
                                <Label Text="{Binding VisitedAt, StringFormat='Ghé thăm lúc: {0:HH:mm - dd/MM/yyyy}'}" 
                                       FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>