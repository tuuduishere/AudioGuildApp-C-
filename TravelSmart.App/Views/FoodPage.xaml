<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSmart.App.FoodPage">

    <VerticalStackLayout Padding="12" Spacing="10">

        <Picker Title="Lọc món" SelectedIndexChanged="OnFilter">
            <Picker.Items>
                <x:String>All</x:String>
                <x:String>Cơm</x:String>
                <x:String>Nước</x:String>
                <x:String>Nhanh</x:String>
            </Picker.Items>
        </Picker>

        <CollectionView x:Name="foodList" ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame HasShadow="True" BorderColor="Transparent" Padding="10" Margin="6" CornerRadius="10" BackgroundColor="{StaticResource Secondary}">
                        <HorizontalStackLayout Spacing="12">
                            <Image Source="{Binding Image}" WidthRequest="72" HeightRequest="72" Aspect="AspectFill" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Category}" FontSize="12" TextColor="{StaticResource Gray600}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>